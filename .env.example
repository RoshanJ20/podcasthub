# =============================================================================
# The Audit Brief — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` (untracked) before running `npm run dev`.
# Never commit a populated `.env`. See:
#   - application-links.md §10            for the full URL-shaped variable reference
#   - docs/deployment-guide.md §16        for the production reference table
#   - lib/auth/env-validation.ts          for startup-time validation
# =============================================================================


# === Database ================================================================
# Local dev: postgresql://auditbrief:auditbrief_dev@localhost:5432/auditbrief
# Azure:     postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL="postgresql://auditbrief:auditbrief_dev@localhost:5432/auditbrief"


# === Auth (NextAuth v4) ======================================================
NEXTAUTH_SECRET="change-me-nextauth-secret-min-32-chars!!"
# NEXTAUTH_URL must include the basePath (/auditbrief) in deployed environments.
# Local dev:  http://localhost:3000/auditbrief
# Production: https://your-domain.com/auditbrief
NEXTAUTH_URL="http://localhost:3000/auditbrief"


# === Storage (Azure Blob — Azurite for local dev) ============================
AZURE_BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
AZURE_BLOB_CONTAINER="the-audit-brief-uploads"


# === Azure OpenAI (semantic search embeddings) ===============================
# Read by lib/embeddings.ts:33-34.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=""
# -----------------------------------------------------------------------------
# Legacy names (kept here for grep / migration awareness, NOT read by code):
#   AZURE_OPENAI_KEY        — superseded by AZURE_OPENAI_API_KEY
#   AZURE_OPENAI_DEPLOYMENT — superseded by AZURE_OPENAI_EMBEDDING_DEPLOYMENT
# The Bicep templates under infra/ still emit the legacy names; keep .env aligned
# with the code (the new names) and update infra in a follow-up.
# -----------------------------------------------------------------------------


# === Microsoft Entra ID SSO (optional) =======================================
# Register an App in Azure Portal > Entra ID > App registrations.
# Redirect URI: http://localhost:3000/auditbrief/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""


# === Observability ===========================================================
# Sentry DSNs are reserved for future use — the SDK is NOT currently initialized.
# Leave blank in all environments until sentry.client/server.config.ts is added.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL="debug"


# === App config ==============================================================
# NEXT_PUBLIC_APP_URL is the origin (scheme+host+port) WITHOUT basePath — used for CORS.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Deployment subpath. Read by both next.config.ts (basePath) and lib/config/base-path.ts.
# Must be kept in sync with the basePath segment of NEXTAUTH_URL above.
NEXT_PUBLIC_BASE_PATH="/auditbrief"
NODE_ENV="development"
# PORT=3103  # Uncomment for production (Azure VM deployment)


# === Performance tuning ======================================================
# Bcrypt cost factor for password hashing. Read by lib/auth/password.ts.
# Default 12 (~250ms on a modern CPU). Set to 4 in test envs for speed.
BCRYPT_SALT_ROUNDS=12

# Slow-query log threshold in milliseconds. Read by lib/db-instrumentation.ts:26.
# Prisma queries exceeding this duration emit a Pino warn log with query metadata.
SLOW_QUERY_THRESHOLD_MS=500
