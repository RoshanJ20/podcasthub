graph TD
    Req["Incoming Request"] --> MW["Edge Middleware\nmiddleware.ts"]

    MW --> GenIDs["Generate x-request-id\n+ CSP nonce (lib/security/csp.ts)"]
    GenIDs --> ClassifyRoute{"Route\nClassification"}

    ClassifyRoute -->|"/ /login /register\n/bulletins /audit-brief/*\n/search /learning-path*\n/unauthorized"| Public["Allow Through\nNo Auth"]
    ClassifyRoute -->|"/api/auth/*\n/api/auth/register"| AuthRoute["Allow Through\nNextAuth endpoints"]
    ClassifyRoute -->|"/api/health\n/api/ready\n/api/media"| Utility["Allow Through\nUtility / public"]
    ClassifyRoute -->|"GET /api/audit-briefs*\nGET /api/learning-graphs*\nGET /api/search"| PublicAPI["Allow Through\nPublic GET API"]
    ClassifyRoute -->|"/admin/*\n/api/admin/*"| AdminCheck{"NextAuth session valid?\nRole = admin or superadmin?"}
    ClassifyRoute -->|"Everything else"| AuthCheck{"NextAuth session valid?\n(getToken in edge)"}

    AuthCheck -->|"Valid"| InjectHeaders["Inject Headers\nx-request-id, x-nonce,\nx-user-id, x-user-email, x-user-role"]
    AuthCheck -->|"Missing / Invalid"| Redirect302["302 to /login?callbackUrl=..."]

    AdminCheck -->|"Valid + correct role"| InjectHeaders
    AdminCheck -->|"Wrong role"| Forbidden["302 to /unauthorized"]
    AdminCheck -->|"No session"| Redirect302

    Public --> AttachCSP
    AuthRoute --> AttachCSP
    Utility --> AttachCSP
    PublicAPI --> AttachCSP
    InjectHeaders --> AttachCSP

    AttachCSP["Attach per-request\nContent-Security-Policy\n(buildContentSecurityPolicy[Dev])"] --> Handler

    Handler["API Route Handler\nor Page Component"] --> RequestLogger["Wrapped by\nlib/api/request-logging-middleware\n(Pino entry log)"]

    RequestLogger --> ValidateInput["Zod Schema\nValidation"]
    ValidateInput -->|"Invalid"| Error422["422 Validation Failed"]
    ValidateInput -->|"Valid"| BusinessLogic["Business Logic\nPrisma queries (with slow-query log),\nAzure Blob ops,\nembeddings, audit log"]

    BusinessLogic -->|"Success"| Response200["200 / 201 JSON Response"]
    BusinessLogic -->|"Not Found"| Error404["404 Not Found"]
    BusinessLogic -->|"Forbidden"| Error403["403 Forbidden"]
    BusinessLogic -->|"Conflict"| Error409["409 Conflict"]
    BusinessLogic -->|"Error"| Error500["500 Internal Error"]

    Error422 --> ErrorFormat["Consistent Error Schema\nstatus, error_code,\nmessage, details, request_id"]
    Error403 --> ErrorFormat
    Error404 --> ErrorFormat
    Error409 --> ErrorFormat
    Error500 --> ErrorFormat

    Response200 --> ResponseLog["Pino exit log\n(duration_ms, status)"]
    ErrorFormat --> ResponseLog

    classDef mw fill:#d4456e,color:#fff
    classDef allow fill:#059669,color:#fff
    classDef deny fill:#dc2626,color:#fff
    classDef logic fill:#2563eb,color:#fff
    classDef check fill:#d97706,color:#fff

    class MW,GenIDs,AttachCSP,RequestLogger,ResponseLog mw
    class Public,AuthRoute,Utility,PublicAPI,InjectHeaders allow
    class Redirect302,Forbidden,Error422,Error403,Error404,Error409,Error500 deny
    class Handler,ValidateInput,BusinessLogic,Response200 logic
    class ClassifyRoute,AuthCheck,AdminCheck check
